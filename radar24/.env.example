# Copiar como .env para referencia; Node no carga archivos .env por defecto.
# En Render: configurar estas claves en Environment.
PORT=3000
RADAR_DB_PATH=./data/radar.sqlite
RADAR_ADMIN_KEY=generar-una-clave-aleatoria-larga
APIFY_TOKEN=
RADAR_AUTO_SCAN=false
RADAR_POLL_MINUTES=360
RADAR_MAX_RUNS_PER_DAY=4
RADAR_RESULTS_PER_QUERY=12
RADAR_TIKTOK_QUERIES=argentina,humor argentino,emprendedores
RADAR_INSTAGRAM_TAGS=argentina,emprendedores,humorargentino
RADAR_MARKET=AR
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
