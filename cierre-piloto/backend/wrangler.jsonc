{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cierre-shadow-api",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "vars": {
    "MODE": "shadow",
    "ALLOWED_ORIGIN": "https://protectorrudo.github.io",
    "FOLLOWUP_HOURS": "36"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cierre-shadow",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],
  "triggers": {
    "crons": [
      "0 3 * * *"
    ]
  }
}
